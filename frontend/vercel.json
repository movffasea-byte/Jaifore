{
  "installCommand": "true",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/(images|logo|icons)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/images/:file",
      "destination": "https://umphewdlugcugohcxvfu.supabase.co/storage/v1/object/public/product-images/:file"
    }
  ]
}
