# Copy to .env and fill in. Never commit the real .env.

PORT=3000
NODE_ENV=development

# Database / cache
DATABASE_URL=postgresql://user:password@host:5432/dbname
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Business clock for email timestamps and Bossy's daily caps (IANA zone)
BUSINESS_TIMEZONE=America/Chicago

# URLs
FRONTEND_URL=http://localhost:5501
BACKEND_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_AUTOMATIC_TAX=false
STRIPE_SHIPPING_COUNTRIES=US,CA

# Email
RESEND_API_KEY=re_...
# Sender address on a domain verified in Resend. Without it, mail goes from
# onboarding@resend.dev, which only reaches the Resend account owner.
MAIL_FROM_ADDRESS=hello@yourdomain.com
ADMIN_EMAIL=admin@example.com

# Monitoring (leave SENTRY_DSN empty to disable Sentry)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Backups
BACKUP_SECRET=change-me
GITHUB_BACKUP_REPO=owner/repo
GITHUB_BACKUP_TOKEN=

# Customer artwork uploads (Supabase Storage). Bucket must be PUBLIC.
# Keep the service-role key server-side only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=artwork

# Exchange rates for the currency estimates (exchangerate-api.com). Server-side only:
# the browser gets rates from /api/fx, never this key.
EXCHANGE_RATE_API_KEY=

# Bossy Bot (Anthropic). Keep the key server-side only.
ANTHROPIC_API_KEY=
BOSSY_MODEL=claude-haiku-5-5
BOSSY_USER_DAILY_CAP=50
# Guests are capped per browser; this ceiling caps all guests on one network address
BOSSY_GUEST_DAILY_CAP=15
BOSSY_GUEST_IP_DAILY_CAP=150
# Signed-in users also count against this per-network-address ceiling
BOSSY_USER_IP_DAILY_CAP=300
# Artwork uploads per customer per 24 hours
UPLOAD_USER_DAILY_CAP=30
BOSSY_IP_SALT=

# Delivery options: extra business days added when an item must be restocked first
BACKORDER_EXTRA_BUSINESS_DAYS=5

# Admin push notifications (web-push). Generate a pair with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Product images bucket (public) used by the admin photo Upload button
SUPABASE_PRODUCT_BUCKET=product-images

# Model that finds the printable area on product photos (admin "Prints on")
PRINT_ZONE_MODEL=claude-opus-5-5
