# Copy to .env and fill in. Never commit the real .env.

PORT=3000
NODE_ENV=development

# Database / cache
DATABASE_URL=postgresql://user:password@host:5432/dbname
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# URLs
FRONTEND_URL=http://localhost:5501
BACKEND_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_AUTOMATIC_TAX=false
STRIPE_SHIPPING_COUNTRIES=US,CA

# Email
RESEND_API_KEY=re_...
ADMIN_EMAIL=admin@example.com

# Monitoring (leave SENTRY_DSN empty to disable Sentry)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Backups
BACKUP_SECRET=change-me
GITHUB_BACKUP_REPO=owner/repo
GITHUB_BACKUP_TOKEN=

# Customer artwork uploads (Supabase Storage). Bucket must be PUBLIC.
# Keep the service-role key server-side only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=artwork
